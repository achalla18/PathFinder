# Copy this file to .env in the repository root.
# Existing shell variables take precedence. Restart commands after changing the region.
# Sharing/demo options: gaithersburg_public, frederick_public, dc.
PF_REGION=gaithersburg_public

# Optional: absolute path for downloads and graph files.
# If omitted, the default is ~/.pathfinder/data. Do not set this to the repository.
# PF_DATA_DIR=/absolute/path/to/pathfinder-data

# Optional: required to bind pf serve to a non-local address.
# Keep deployments private; use HTTPS when serving over a network.
# PF_APP_PASSWORD=replace-with-your-own-password

# Optional research tool credential; not needed for the Maryland public-region walkthrough.
# PF_MAPILLARY_TOKEN=
# Optional live Metro notices / DC feed (skipped if unavailable).
# WMATA_API_KEY=
